# Local development: copy to .env.   Vercel: add the SAME names under Project → Settings → Environment Variables.
# NEVER commit .env. None of these values is ever sent to the browser.
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_ANON_KEY=your-anon-public-key
# Server-side only (bypasses RLS). Used only by the PHP files in /api and /lib.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Optional. Leave empty and the site address is detected automatically (used in password-reset emails).
FRONTEND_URL=
APP_DEBUG=false
